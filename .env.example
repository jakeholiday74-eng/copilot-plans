# Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# API
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database (optional for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copilot_plans
DB_USER=postgres
DB_PASSWORD=

# Security
JWT_SECRET=your-secret-key-here
API_KEY=free-pro-agent-key

# Features
ENABLE_CACHING=true
ENABLE_LOGGING=true
CACHE_TTL=3600
